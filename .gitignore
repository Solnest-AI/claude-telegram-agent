# ── secrets / config (NEVER commit) ──
.env
.env.*
!.env.example
*.key
*.pem

# ── python ──
.venv/
venv/
__pycache__/
*.pyc

# ── runtime data (private — never publish) ──
logs/
state/
transcripts/

# ── updater: backups of replaced files, the list of files this copy shipped ──
.update-backup/
.telegram-agent-files.txt

# ── os cruft ──
.DS_Store
Thumbs.db
