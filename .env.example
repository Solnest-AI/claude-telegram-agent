# ─────────────────────────────────────────────────────────────────────────────
# Claude Telegram Agent — configuration
# Copy this file to ".env" (same folder) and fill in the two REQUIRED values.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Everything else has a safe default — change later as you like.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Your bot token from @BotFather (looks like 8717809381:AAH...long-string).
# This is the keys to your machine — never commit it, never share it.
TELEGRAM_BOT_TOKEN=PASTE_YOUR_TOKEN_HERE

# Your numeric Telegram user id from @userinfobot. The bot ONLY listens to ids
# in this list. Comma-separate to allow more than one person: 111111,222222
TELEGRAM_ALLOWED_USERS=PASTE_YOUR_ID_HERE


# ── BASICS ───────────────────────────────────────────────────────────────────

# Your name (only used when it logs conversations).
USER_NAME=Me

# The folder Claude works in by default. A broad root lets it reach your stuff.
#   macOS/Linux example:  CLAUDE_CWD=/Users/you
#   Windows example:      CLAUDE_CWD=C:\Users\you
# Leave blank to default to your home folder.
CLAUDE_CWD=

# How approvals work:
#   default            = safe/read-only stuff auto-runs; risky stuff (Write/Edit/
#                        deletes/sends) asks you with Approve/Deny buttons. RECOMMENDED.
#   bypassPermissions  = ZERO approvals, everything runs automatically. Full send —
#                        only do this once you trust it and the machine is yours.
PERMISSION_MODE=default

# Tools that run WITHOUT asking, on top of read-only ones. Bash is here so you
# aren't tapping Approve for every shell command. Add Write,Edit to also skip
# file-write prompts. Leave empty to be asked about Bash too.
AUTO_APPROVE_TOOLS=Bash,BashOutput

# Seconds to wait for you to tap Approve before it auto-denies.
APPROVAL_TIMEOUT=300

# How often (seconds) an idle bot pings Claude and silently reconnects if the
# subprocess died, so the next real message doesn't wait out a reconnect. 0 = off.
HEALTH_CHECK_SECONDS=180

# Where the bot keeps its session id, temp downloads and images.
# Leave blank for ./state inside this folder.
STATE_DIR=

# Localhost port used only as a single-instance lock. Change it if something else
# on your machine already uses 49737.
LOCK_PORT=49737


# ── CLAUDE / MCP / SKILLS ────────────────────────────────────────────────────

# Pin a specific model (e.g. claude-opus-4-8) ONLY if your plan has access to it.
# Leave blank to use whatever your Claude subscription defaults to (most portable).
ANTHROPIC_MODEL=

# Skills to enable: all | none | or a comma list of skill names.
SKILLS=all

# MCP servers (from your ~/.claude.json) to SKIP loading — comma list.
# Leave blank to load them all. Set names here if one is broken or slow.
MCP_EXCLUDE=


# ── TRANSCRIPT LOGGING (optional) ────────────────────────────────────────────

# Append every conversation turn to dated .md files in this folder. Point it at an
# Obsidian vault if you want. Set to "none" to turn it off.
#   example:  VAULT_CAPTURE_DIR=/Users/you/Obsidian/Inbox/Telegram
VAULT_CAPTURE_DIR=none

# How many characters of each tool result get written into that transcript.
VAULT_RESULT_MAX=800


# ── VOICE (all optional) ─────────────────────────────────────────────────────

# Voice-IN (you send a voice note -> transcribed locally, free + private).
# Requires the optional Apple-Silicon-only dep:  pip install -r requirements-voice.txt
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Voice-OUT (spoken replies via ElevenLabs). Cross-platform. Needs ffmpeg installed.
# Leave ELEVENLABS_API_KEY blank to disable spoken replies entirely.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Replies longer than this many characters are sent as text only (not spoken).
TTS_MAX_CHARS=1000
